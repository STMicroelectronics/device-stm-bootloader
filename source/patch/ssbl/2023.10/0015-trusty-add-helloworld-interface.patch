+
+#ifndef TRUSTY_HW_H_
+#define TRUSTY_HW_H_
+
+#include <interface/helloworld/helloworld.h>
+#include <trusty/sysdeps.h>
+#include <trusty/trusty_ipc.h>
+
+/*
+ * Initialize Hello-World TIPC client. Returns one of trusty_err.
+ *
+ * @dev: initialized with trusty_ipc_dev_create
+ */
+int hw_tipc_init(struct trusty_ipc_dev* dev);
+/*
+ * Shutdown Hello-World TIPC client.
+ *
+ * @dev: initialized with trusty_ipc_dev_create
+ */
+void hw_tipc_shutdown(struct trusty_ipc_dev* dev);
+/*
+ * Write a message to secure side.
+ * The secure side will reply with "Hello, {}!" with {} replaced by the message.
+ *
+ * Returns one of trusty_err.
+ */
+int trusty_hello_world(uint8_t length, const uint8_t* message, uint8_t *res);
+
+#endif /* TRUSTY_HW_H_ */
