+#ifndef TRUSTY_INTERFACE_HW_H_
+#define TRUSTY_INTERFACE_HW_H_
+
+#include <trusty/sysdeps.h>
+
+#define HELLO_WORLD_PORT "com.android.trusty.hello"
+#define HW_MAX_BUFFER_LENGTH 100
+
+/**
+ * enum hw_tag - Tags can either identify a String in a method, or an error.
+ * @HW_TAG_STRING:  Message is a response string
+ * @HW_TAG_ERROR:   Message is an error
+ *
+ */
+enum hw_tag : uint8_t {
+    HW_TAG_STRING = 1,
+    HW_TAG_ERROR = 2,
+};
+
+/**
+ * hw_message - Serial header for communicating with HelloWorld server
+ * @tag: identify the message type
+ * @length: the length of the message
+ * @message: the data received/send
+ */
+struct hw_message {
+    enum hw_tag tag;
+    uint8_t length;
+    uint8_t message[HW_MAX_BUFFER_LENGTH];
+};
+
+#endif /* TRUSTY_INTERFACE_HW_H_ */
diff --git a/include/trusty/helloworld.h b/include/trusty/helloworld.h
