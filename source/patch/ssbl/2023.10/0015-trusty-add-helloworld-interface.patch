diff --git a/lib/trusty/ql-tipc/helloworld.c b/lib/trusty/ql-tipc/helloworld.c
new file mode 100644
index 00000000000..b6ee5f3b174
--- /dev/null
+++ b/lib/trusty/ql-tipc/helloworld.c
@@ -0,0 +1,130 @@
+/*
+ * Copyright (C) 2016 The Android Open Source Project
+ *
+ * Permission is hereby granted, free of charge, to any person
+ * obtaining a copy of this software and associated documentation
+ * files (the "Software"), to deal in the Software without
+ * restriction, including without limitation the rights to use, copy,
+ * modify, merge, publish, distribute, sublicense, and/or sell copies
+ * of the Software, and to permit persons to whom the Software is
+ * furnished to do so, subject to the following conditions:
+ *
+ * The above copyright notice and this permission notice shall be
+ * included in all copies or substantial portions of the Software.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND,
+ * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF
+ * MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
+ * NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS
+ * BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN
+ * ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN
+ * CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
+ * SOFTWARE.
+ */
+
+#include <trusty/helloworld.h>
+#include <trusty/trusty_ipc.h>
+#include <trusty/util.h>
+
+#define LOCAL_LOG 0
+
+#define MESSAGE_OFFSET 2
+
+static bool initialized;
+static struct trusty_ipc_chan hw_chan;
+
+static int hw_send_request(struct hw_message* msg) {
+    struct trusty_ipc_iovec req_iovs[1] = {
+            {.base = msg, .len = MESSAGE_OFFSET + msg->length},
+    };
+
+    return trusty_ipc_send(&hw_chan, req_iovs, 1, true);
+}
+
+static int hw_read_response(struct hw_message* msg) {
+    int rc;
+    struct trusty_ipc_iovec resp_iovs[1] = {
+            {.base = msg, .len = MESSAGE_OFFSET + HW_MAX_BUFFER_LENGTH},
+    };
+
+    rc = trusty_ipc_recv(&hw_chan, resp_iovs, 1, true);
+    if (rc < 0) {
+        trusty_error("failed (%d) to recv response\n", rc);
+        return rc;
+    }
+
+    return rc;
+}
+
+int hw_tipc_init(struct trusty_ipc_dev* dev) {
+    int rc;
+
+    trusty_assert(dev);
+    trusty_assert(!initialized);
+
+    trusty_ipc_chan_init(&hw_chan, dev);
+    trusty_debug("Connecting to HelloWorld service\n");
+
+    /* connect to Hello World service and wait for connect to complete */
+    rc = trusty_ipc_connect(&hw_chan, HELLO_WORLD_PORT, true);
+    if (rc < 0) {
+        trusty_error("failed (%d) to connect to '%s'\n", rc, HELLO_WORLD_PORT);
+        return rc;
+    }
+
+    /* mark as initialized */
+    initialized = true;
+
+    return TRUSTY_ERR_NONE;
+}
+
+void hw_tipc_shutdown(struct trusty_ipc_dev* dev) {
+    if (!initialized)
+        return; /* nothing to do */
+
+    /* close channel */
+    trusty_ipc_close(&hw_chan);
+
+    initialized = false;
+}
+
+int trusty_hello_world(uint8_t length, const uint8_t* message, uint8_t* res) {
+    int rc;
+    struct hw_message msg = {
+        .tag = HW_TAG_STRING,
+        .length = length,
+    };
+
+    memcpy(msg.message, message, length);
+
+    if (!initialized) {
+        trusty_error("%s: HelloWorld TIPC client not initialized\n", __func__);
+        return TRUSTY_ERR_GENERIC;
+    }
+
+    rc = hw_send_request(&msg);
+    if (rc < 0) {
+        trusty_error("%s: failed (%d) to send HelloWorld request\n", __func__, rc);
+        return rc;
+    }
+
+    rc = hw_read_response(&msg);
+    if (rc < 0) {
+        trusty_error("%s: failed (%d) to read HelloWorld response\n", __func__, rc);
+        return rc;
+    }
+
+    if (msg.length > HW_MAX_BUFFER_LENGTH) {
+        trusty_error("%s: the message is too big\n", __func__);
+        return TRUSTY_ERR_GENERIC;
+    }
+
+    if (msg.tag == HW_TAG_ERROR) {
+        trusty_error("%s: HelloWorld service returned error (%s)\n", __func__, msg.message);
+        return TRUSTY_ERR_GENERIC;
+    }
+
+    memcpy(res, msg.message, msg.length);
+
+    return TRUSTY_ERR_NONE;
+}
diff --git a/lib/trusty/ql-tipc/libtipc.c b/lib/trusty/ql-tipc/libtipc.c
index a582f49998f..7bce6aad89c 100644
--- a/lib/trusty/ql-tipc/libtipc.c
+++ b/lib/trusty/ql-tipc/libtipc.c
@@ -25,6 +25,7 @@
 #include <trusty/avb.h>
 #include <trusty/keymaster.h>
 #include <trusty/rpmb.h>
+#include <trusty/helloworld.h>
 #include <trusty/trusty_dev.h>
 #include <trusty/trusty_ipc.h>
 #include <trusty/util.h>
@@ -44,6 +45,10 @@ void trusty_ipc_shutdown(void) {
     (void)avb_tipc_shutdown(_ipc_dev);
     (void)km_tipc_shutdown(_ipc_dev);
 
+#ifdef CONFIG_TRUSTY_TA_HELLO_WORLD
+    (void)hw_tipc_shutdown(_ipc_dev);
+#endif
+
     /* shutdown Trusty IPC device */
     (void)trusty_ipc_dev_shutdown(_ipc_dev);
 
@@ -95,5 +100,14 @@ int trusty_ipc_init(void) {
         return rc;
     }
 
+#ifdef CONFIG_TRUSTY_TA_HELLO_WORLD
+    trusty_info("Initializing Trusty HelloWorld client\n");
+    rc = hw_tipc_init(_ipc_dev);
+    if (rc != 0) {
+        trusty_error("Initlializing Trusty HelloWorld client failed (%d)\n", rc);
+        return rc;
+    }
+#endif
+
     return TRUSTY_ERR_NONE;
 }
