diff --git a/lib/trusty/ql-tipc/libtipc.c b/lib/trusty/ql-tipc/libtipc.c
index f2f50760ae6..3f85cce452a 100644
--- a/lib/trusty/ql-tipc/libtipc.c
+++ b/lib/trusty/ql-tipc/libtipc.c
@@ -46,7 +46,9 @@ void trusty_ipc_shutdown(void) {
     (void)avb_tipc_shutdown(_ipc_dev);
 #endif
 
+#ifdef CONFIG_TRUSTY_TA_KEYMASTER
     (void)km_tipc_shutdown(_ipc_dev);
+#endif
 
 #ifdef CONFIG_TRUSTY_TA_HELLO_WORLD
     (void)hw_tipc_shutdown(_ipc_dev);
@@ -98,12 +100,14 @@ int trusty_ipc_init(void) {
