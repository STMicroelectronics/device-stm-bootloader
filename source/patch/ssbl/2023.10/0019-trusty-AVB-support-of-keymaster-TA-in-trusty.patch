From: Yves COPPEAUX <yves.coppeaux@st.com>
Date: Wed, 7 May 2025 10:27:59 +0200
Subject: [PATCH 19/23] trusty : AVB, support of keymaster TA in trusty

---
 cmd/avb.c                    | 223 +++++++++++++++++++++++++++++++++++
 common/avb_verify.c          |   6 +
 include/avb_verify.h         |   1 +
 lib/trusty/Kconfig           |   6 +
 lib/trusty/ql-tipc/Makefile  |   6 +-
 lib/trusty/ql-tipc/libtipc.c |   4 +
 6 files changed, 244 insertions(+), 2 deletions(-)

diff --git a/cmd/avb.c b/cmd/avb.c
index ee89122de8a..8e31a15a3cd 100644
--- a/cmd/avb.c
+++ b/cmd/avb.c
@@ -13,9 +13,225 @@
 #include <memalign.h>
 #include <mmc.h>
 
+#ifdef CONFIG_TRUSTY_TA_KEYMASTER
+#include <trusty/keymaster.h>
+#include <android_image.h>
+#endif
+
 #define AVB_BOOTARGS	"avb_bootargs"
 static struct AvbOps *avb_ops;
 
+static u32 android_image_get_os_version(const struct andr_boot_img_hdr_v3 *hdr)
+{
+	return hdr->os_version;
+}
+
+#ifdef CONFIG_TRUSTY_TA_KEYMASTER
+static int set_boot_params(AvbSlotVerifyData *slot_data,
+			   AvbSlotVerifyResult slot_result, bool unlocked)
+{
+	int ret = 0;
+
+	/* Read OS version */
+	char boot_part_name[10] = { 0 };
+	struct andr_boot_img_hdr_v3 hdr;
+	size_t hdr_num_read;
+	snprintf(boot_part_name, sizeof(boot_part_name), "boot%s", slot_data->ab_suffix);
+	AvbIOResult res = avb_ops->read_from_partition(avb_ops, boot_part_name,
+					   0, sizeof(struct andr_boot_img_hdr_v3),
+					   &hdr, &hdr_num_read);
+	if (res != AVB_IO_RESULT_OK ||
+	    sizeof(struct andr_boot_img_hdr_v3) != hdr_num_read) {
+		ret = -1;
+		goto end;
+	}
+
+	u32 os_version = android_image_get_os_version(&hdr);
+	if (os_version == (u32)-1) {
+		printf("keymaster: error: unable to retrieve the os_version "
+		       "in the Android boot image\n");
+		ret = -1;
+		goto end;
+	}
+
+	u32 os_ver = os_version >> 11;
+	u32 os_ver_km = (((os_ver >> 14) & 0x7F) * 100 +
+			     ((os_ver >> 7) & 0x7F)) * 100 + (os_ver & 0x7F);
+
+	u32 os_lvl = os_version & ((1U << 11) - 1);
+	u32 os_lvl_km = ((os_lvl >> 4) + 2000) * 100 + (os_lvl & 0x0F);
+
+	/* Get verified boot status */
+	keymaster_verified_boot_t vbstatus = KM_VERIFIED_BOOT_UNVERIFIED;
+	if (!unlocked && slot_result == AVB_SLOT_VERIFY_RESULT_OK) {
+		vbstatus = KM_VERIFIED_BOOT_VERIFIED;
+	}
+
+	/* Get boot key hash */
+	uint8_t bkh[AVB_SHA256_DIGEST_SIZE] = { 0 };
+	if (!unlocked)
+		avb_root_pub_sha256(bkh);
+
+	/* Byteswap top-level vbmeta header since we'll need it below. */
+	AvbVBMetaImageHeader toplevel_vbmeta;
+	avb_vbmeta_image_header_to_host_byte_order(
+		(const AvbVBMetaImageHeader *)slot_data->vbmeta_images[0].vbmeta_data,
+		&toplevel_vbmeta);
+
+	/* Get hash size */
+	uint32_t hash_size;
+	AvbDigestType digest_type;
+	switch ((AvbAlgorithmType)toplevel_vbmeta.algorithm_type) {
+		case AVB_ALGORITHM_TYPE_NONE:
+		case AVB_ALGORITHM_TYPE_SHA256_RSA2048:
+		case AVB_ALGORITHM_TYPE_SHA256_RSA4096:
+		case AVB_ALGORITHM_TYPE_SHA256_RSA8192:
+			hash_size = AVB_SHA256_DIGEST_SIZE;
+			digest_type = AVB_DIGEST_TYPE_SHA256;
+			break;
+		case AVB_ALGORITHM_TYPE_SHA512_RSA2048:
+		case AVB_ALGORITHM_TYPE_SHA512_RSA4096:
+		case AVB_ALGORITHM_TYPE_SHA512_RSA8192:
+			hash_size = AVB_SHA512_DIGEST_SIZE;
+			digest_type = AVB_DIGEST_TYPE_SHA512;
+			break;
+		default:
+			ret = -1;
+			goto end;
+	}
+
+	/* Get verified boot hash */
+	uint8_t *vbh = malloc(hash_size);
+	avb_slot_verify_data_calculate_vbmeta_digest(slot_data, digest_type, vbh);
+
+	if (trusty_set_boot_params(os_ver_km, os_lvl_km, vbstatus, !unlocked,
+				   bkh, AVB_SHA256_DIGEST_SIZE,
+				   vbh, hash_size)) {
+		printf("keymaster: error: set boot parameters failed !\n");
+		ret = -1;
+	}
+
+	free(vbh);
+
+end:
+	return ret;
+}
+
+static int set_patch_level(AvbSlotVerifyData *slot_data)
+{
+	int ret = 0;
+	AvbIOResult res;
+	AvbFooter footer;
+	char *boot_patch_level = NULL;
+	size_t patch_level_size = 0;
+	uint8_t *vbmeta_data = NULL;
+	size_t vbmeta_num_read;
+	size_t footer_num_read;
+	uint8_t footer_buf[AVB_FOOTER_SIZE];
+	char boot_part_name[10] = { 0 };
+
+	/* Get the vbmeta footer of 'boot' partition */
+	snprintf(boot_part_name, sizeof(boot_part_name), "boot%s", slot_data->ab_suffix);
+	res = avb_ops->read_from_partition(avb_ops, boot_part_name,
+					   -AVB_FOOTER_SIZE, AVB_FOOTER_SIZE,
+					   footer_buf, &footer_num_read);
+	if (res != AVB_IO_RESULT_OK || footer_num_read != AVB_FOOTER_SIZE) {
+		printf("read boot image footer failed!\n");
+		ret = -1;
+		goto end;
+	} else if (!avb_footer_validate_and_byteswap((AvbFooter *)footer_buf,
+						     &footer)) {
+		printf("failed to find vbmeta footer!\n");
+		ret = -1;
+		goto end;
+	}
+
+	/* Get vbmeta struct in 'boot' partition */
+	vbmeta_data = malloc(footer.vbmeta_size);
+	if (vbmeta_data == NULL) {
+		printf("failed to allocate memory!\n");
+		ret = -1;
+		goto end;
+	}
+	res = avb_ops->read_from_partition(avb_ops, boot_part_name,
+					   footer.vbmeta_offset,
+					   footer.vbmeta_size,
+					   vbmeta_data, &vbmeta_num_read);
+	if (res != AVB_IO_RESULT_OK || vbmeta_num_read != footer.vbmeta_size) {
+		printf("read vbmeta struct in boot image failed!\n");
+		ret = -1;
+		goto end;
+	}
+
+	const char *aux = avb_property_lookup(vbmeta_data, footer.vbmeta_size,
+				"com.android.build.boot.security_patch",
+				0, &patch_level_size);
+	if (aux) {
+		boot_patch_level = avb_strdup(aux);
+		char *tmp = strsep(&boot_patch_level, "-");
+		if (!tmp) {
+			printf("invalid boot security patch level!\n");
+			ret = -1;
+			goto end;
+		}
+
+		uint32_t year = simple_strtoul(tmp, NULL, 10);
+		if (year < 1970) {
+			printf("invalid boot security patch level!\n");
+			ret = -1;
+			goto end;
+		}
+
+		tmp = strsep(&boot_patch_level, "-");
+		if (!tmp) {
+			printf("invalid boot security patch level!\n");
+			ret = -1;
+			goto end;
+		}
+
+		uint32_t month = simple_strtoul(tmp, NULL, 10);
+		if (month < 1 || month > 12) {
+			printf("invalid boot security patch level!\n");
+			ret = -1;
+			goto end;
+		}
+
+		tmp = strsep(&boot_patch_level, "-");
+		if (!tmp || boot_patch_level) {
+			printf("keymaster: error: invalid patch level !\n");
+			ret = -1;
+			goto end;
+		}
+
+		uint32_t day = simple_strtoul(tmp, NULL, 10);
+		if (day < 1 || day > 31) {
+			printf("keymaster: error: invalid patch level !\n");
+			ret = -1;
+			goto end;
+		}
+
+		uint32_t res = year * 10000 + month * 100 + day;
+		if (trusty_set_boot_patch_level(res)) {
+			printf("keymaster: error: set boot patch level failed !\n");
+			ret = -1;
+			goto end;
+		}
+	} else {
+		printf("No boot patch level found!\n");
+		ret = -1;
+	}
+
+end:
+	if (vbmeta_data != NULL)
+		free(vbmeta_data);
+
+	if (boot_patch_level)
+		avb_free(boot_patch_level);
+
+	return ret;
+}
+#endif
+
 int do_avb_init(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
 {
 	unsigned long mmc_dev;
@@ -329,6 +545,13 @@ int do_avb_verify_part(struct cmd_tbl *cmdtp, int flag,
 		env_set(AVB_BOOTARGS, cmdline);
 	}
 
+#ifdef CONFIG_TRUSTY_TA_KEYMASTER
+	if (res == CMD_RET_SUCCESS) {
+		set_boot_params(out_data, slot_result, unlocked);
+		set_patch_level(out_data);
+	}
+#endif
+
 	if (out_data)
 		avb_slot_verify_data_free(out_data);
 
diff --git a/common/avb_verify.c b/common/avb_verify.c
index 9925dca8176..623dbc19a6f 100644
--- a/common/avb_verify.c
+++ b/common/avb_verify.c
@@ -125,6 +125,12 @@ static const unsigned char avb_root_pub[1032] = {
 	0xd8, 0x7e,
 };
 
+void avb_root_pub_sha256(unsigned char *sha256_out)
+{
+	sha256_csum_wd(avb_root_pub, AVB_SHA256_DIGEST_SIZE,
+		       sha256_out, CHUNKSZ_SHA256);
+}
+
 /**
  * ============================================================================
  * Boot states support (GREEN, YELLOW, ORANGE, RED) and dm_verity
diff --git a/include/avb_verify.h b/include/avb_verify.h
index 1e787ba6668..bd2ac4225ae 100644
--- a/include/avb_verify.h
+++ b/include/avb_verify.h
@@ -49,6 +49,7 @@ enum mmc_io_type {
 AvbOps *avb_ops_alloc(int boot_device);
 void avb_ops_free(AvbOps *ops);
 
+void avb_root_pub_sha256(unsigned char *sha256_out);
 char *avb_set_state(AvbOps *ops, enum avb_boot_state boot_state);
 char *avb_set_enforce_verity(const char *cmdline);
 char *avb_set_ignore_corruption(const char *cmdline);
diff --git a/lib/trusty/Kconfig b/lib/trusty/Kconfig
index a42bab55743..dd8459f9a8e 100644
--- a/lib/trusty/Kconfig
+++ b/lib/trusty/Kconfig
@@ -9,6 +9,12 @@ if TRUSTY_LIB
 
 menu "Trusty options"
 
+config TRUSTY_TA_KEYMASTER
+	bool "Support KEYMASTER TA"
+	default y
+	help
+	  Enables support for the Keymaster Trusted Application (TA) in Trusty.
+
 config TRUSTY_TA_AVB
 	bool "Support AVB TA"
 	default y
diff --git a/lib/trusty/ql-tipc/Makefile b/lib/trusty/ql-tipc/Makefile
index 5b0fd5fd536..388df0974e3 100644
--- a/lib/trusty/ql-tipc/Makefile
+++ b/lib/trusty/ql-tipc/Makefile
@@ -30,8 +30,6 @@ TRUSTY_DIR = lib/trusty
 
 QL_TIPC = .
 obj-y += \
