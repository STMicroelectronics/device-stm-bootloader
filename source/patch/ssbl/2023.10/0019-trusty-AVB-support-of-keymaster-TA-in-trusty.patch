-    $(QL_TIPC)/keymaster_serializable.o \
     $(QL_TIPC)/ipc.o \
     $(QL_TIPC)/ipc_dev.o \
     $(QL_TIPC)/libtipc.o \
@@ -44,6 +42,10 @@ obj-y += \
 obj-$(CONFIG_TRUSTY_TA_AVB) += \
     $(QL_TIPC)/avb.o \
 
