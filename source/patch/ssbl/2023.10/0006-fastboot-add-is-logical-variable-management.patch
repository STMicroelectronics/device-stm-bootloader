From e82737b9c88d66da0999d666e34ec84571c3e6a7 Mon Sep 17 00:00:00 2001
From: Nicolas LOUBOUTIN <nicolas.louboutin@st.com>
Date: Thu, 14 Dec 2023 17:00:41 +0100
Subject: [PATCH 06/23] fastboot: add is-logical variable management

Add getvar service to check if a partition is physical or logical.
By default a partition not found is considered logical.

Signed-off-by: Nicolas LOUBOUTIN <nicolas.louboutin@st.com>
---
 drivers/fastboot/fb_getvar.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/drivers/fastboot/fb_getvar.c b/drivers/fastboot/fb_getvar.c
index dd3475e0a8b..59354a9812b 100644
--- a/drivers/fastboot/fb_getvar.c
+++ b/drivers/fastboot/fb_getvar.c
@@ -25,6 +25,7 @@ static void getvar_has_slot(char *var_parameter, char *response);
 static void getvar_partition_type(char *part_name, char *response);
 static void getvar_partition_size(char *part_name, char *response);
 static void getvar_is_userspace(char *var_parameter, char *response);
+static void getvar_is_logical(char *part_name, char *response);
 
 static const struct {
 	const char *variable;
@@ -75,6 +76,9 @@ static const struct {
 	}, {
 		.variable = "is-userspace",
 		.dispatch = getvar_is_userspace
+	}, {
+		.variable = "is-logical",
+		.dispatch = getvar_is_logical
 	}
 };
 
@@ -236,6 +240,19 @@ static void getvar_is_userspace(char *var_parameter, char *response)
 	fastboot_okay("no", response);
 }
 
+static void getvar_is_logical(char *part_name, char *response)
+{
+	int r;
+	size_t size;
+
+	r = getvar_get_part_info(part_name, response, &size);
+	if (r >= 0)
+		fastboot_okay("no", response);
+	else
+		// if not physical, consider the partition logical by default (te be improved)
+		fastboot_okay("yes", response);
+}
+
 /**
  * fastboot_getvar() - Writes variable indicated by cmd_parameter to response.
  *
-- 
2.34.1

