From aa545700e7022f0a7dd1e8e74c0cfcbdaf224be9 Mon Sep 17 00:00:00 2001
From: Yves COPPEAUX <yves.coppeaux@st.com>
Date: Thu, 17 Apr 2025 13:21:28 +0200
Subject: [PATCH 16/26] cmd: trusty: create a helloworld command to test

---
 cmd/Kconfig                 | 11 +++++++++++
 cmd/Makefile                |  4 ++++
 cmd/helloworld.c            | 30 ++++++++++++++++++++++++++++++
 configs/stm32mp25_defconfig |  1 +
 4 files changed, 46 insertions(+)
 create mode 100644 cmd/helloworld.c

diff --git a/cmd/Kconfig b/cmd/Kconfig
index 43ca10f69cc..eb7f9d79143 100644
--- a/cmd/Kconfig
+++ b/cmd/Kconfig
@@ -2831,6 +2831,17 @@ config CMD_STACKPROTECTOR_TEST
 
 endmenu
 
+menu "Trusty commands"
+
+config CMD_HELLO_WORLD
+	bool "Enable helloworld command"
+	depends on TRUSTY_TA_HELLO_WORLD
+	help
+	  Enable helloworld command
+	  The helloworld command will allow to test the trusty communication.
+
+endmenu
+
 config CMD_UBI
 	tristate "Enable UBI - Unsorted block images commands"
 	select MTD_UBI
diff --git a/cmd/Makefile b/cmd/Makefile
index 9bebf321c39..70f2e4bf32c 100644
--- a/cmd/Makefile
+++ b/cmd/Makefile
@@ -214,6 +214,10 @@ obj-$(CONFIG_CMD_ETHSW) += ethsw.o
 obj-$(CONFIG_CMD_AXI) += axi.o
 obj-$(CONFIG_CMD_PVBLOCK) += pvblock.o
 
+ifdef CONFIG_TRUSTY_LIB
+obj-$(CONFIG_CMD_HELLO_WORLD) += helloworld.o
+endif
+
 # Power
 obj-$(CONFIG_CMD_PMIC) += pmic.o
 obj-$(CONFIG_CMD_REGULATOR) += regulator.o
diff --git a/cmd/helloworld.c b/cmd/helloworld.c
new file mode 100644
index 00000000000..907c14a4557
--- /dev/null
+++ b/cmd/helloworld.c
@@ -0,0 +1,30 @@
+
+#include <common.h>
+#include <command.h>
+
+#include "trusty/helloworld.h"
+
+static int do_helloworld(struct cmd_tbl *cmdtp, int flag, int argc, char * const argv[])
+{
+	argc--; argv++;
+
+	if (argc != 1)
+		return CMD_RET_USAGE;
+
+	uint8_t res[100] = { 0 };
+
+	trusty_hello_world(strlen(argv[0]), argv[0], res);
+
+	printf("%s\n", res);
+
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(
+	helloworld, 2, 1, do_helloworld,
+	"Trusty helloworld commands",
+	"\n"
+	"helloworld [msg]   - send a message to the helloworld service.\n"
+	"                     the service should reply \"Hello, {}!\" with {} replaced by msg\n"
+	""
+);
diff --git a/configs/stm32mp25_defconfig b/configs/stm32mp25_defconfig
index 9ec7ee0a5a2..066988527e5 100644
--- a/configs/stm32mp25_defconfig
+++ b/configs/stm32mp25_defconfig
@@ -70,6 +70,7 @@ CONFIG_CMD_MTDPARTS=y
 CONFIG_CMD_LOG=y
 CONFIG_CMD_AVB=y
 CONFIG_CMD_UBI=y
+CONFIG_CMD_HELLO_WORLD=y
 CONFIG_OF_LIVE=y
 CONFIG_ENV_IS_NOWHERE=y
 CONFIG_ENV_IS_IN_FLASH=y
-- 
2.34.1

