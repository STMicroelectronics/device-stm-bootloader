+const char* trusty_basename(const char* str) {
+    int64_t n;
+    size_t len;
+
+    len = trusty_strlen(str);
+    if (len >= 2) {
+        for (n = len - 2; n >= 0; n--) {
+            if (str[n] == '/') {
+                return str + n + 1;
+            }
+        }
+    }
+    return str;
+}
