From 463dda61c538a7c9b83f192f7810bb002af3fca9 Mon Sep 17 00:00:00 2001
From: Nicolas LOUBOUTIN <nicolas.louboutin@st.com>
Date: Mon, 3 Nov 2025 08:23:44 +0100
Subject: [PATCH 13/14] configs: increase max args for env set command

Signed-off-by: Nicolas LOUBOUTIN <nicolas.louboutin@st.com>
---
 configs/stm32mp25_defconfig | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/configs/stm32mp25_defconfig b/configs/stm32mp25_defconfig
index 2c998dda776..71e2bcfda80 100644
--- a/configs/stm32mp25_defconfig
+++ b/configs/stm32mp25_defconfig
@@ -3,6 +3,7 @@ CONFIG_USE_ARCH_MEMCPY=y
 CONFIG_ARCH_STM32MP=y
 CONFIG_SYS_MALLOC_LEN=0x4800000
 CONFIG_SYS_MALLOC_F_LEN=0x400000
+CONFIG_ENV_SIZE=0x4000
 CONFIG_ENV_OFFSET=0x480000
 CONFIG_DEFAULT_DEVICE_TREE="stm32mp257f-ev1"
 CONFIG_SYS_PROMPT="STM32MP> "
@@ -10,6 +11,7 @@ CONFIG_STM32MP25X=y
 CONFIG_CMD_STM32KEY=y
 CONFIG_TARGET_ST_STM32MP25X=y
 CONFIG_CMD_STM32PROG=y
+CONFIG_SYS_MAXARGS=24
 CONFIG_SYS_LOAD_ADDR=0x84000000
 CONFIG_ENV_ADDR=0x60900000
 CONFIG_FWU_NUM_IMAGES_PER_BANK=1
-- 
2.34.1

