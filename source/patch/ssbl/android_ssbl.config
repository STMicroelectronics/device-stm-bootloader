# WARNING: KEEP THE ORDER AND NO SPACE BEFORE BOOTLOADER_xxx PARAMETERS

# For the BOOTLOADER module you have to give the following information:

# BOOTLOADER_VERSION <version> (version required)

# BOOTLOADER_FILE_PATH <path> (relative directory path where to load the bootloader source)

# BOOTLOADER_ARCHIVE_PATH <path> (URL used to load archive)
# or
# BOOTLOADER_GIT_PATH <path> (GIT URL used to clone containing)

# If specific commit required (optional, only valid for GIT and not ARCHIVE load)
# BOOTLOADER_GIT_SHA1 <sha1> (GIT SHA1 required - if not defined the BOOTLOADER_VERSION set is used)

# If additional patches are required (optional)
# BOOTLOADER_PATCH_1 <file name> (file name with or without suffix)
# ...
# BOOTLOADER_PATCH_<n> <file name> (file name with or without suffix)

BOOTLOADER_VERSION 2022.10

BOOTLOADER_FILE_PATH device/stm/stm32mp2-bootloader/u-boot-stm32mp2
# By default, the archive is loaded
# BOOTLOADER_ARCHIVE_PATH https://github.com/u-boot/u-boot

BOOTLOADER_GIT_PATH https://github.com/u-boot/u-boot
BOOTLOADER_GIT_SHA1 4debc57a3da6c3f4d3f89a637e99206f4cea0a96

BOOTLOADER_PATCH_1 0001-v2022.10-stm32mp-r2.patch
BOOTLOADER_PATCH_2 0002-U-BOOT-v2022.10-stm32mp-r2.1-Signed-off-by-vermaash-.patch
BOOTLOADER_PATCH_3 0003-ARM-v2022.10-stm32mp-CONFIG-add-on-for-Android.patch
BOOTLOADER_PATCH_4 0004-ARM-v2022.10-stm32mp-BOARD-add-on-for-Android.patch
BOOTLOADER_PATCH_5 0005-avb-Fix-alignment-warning-when-flushing-the-cache-af.patch
BOOTLOADER_PATCH_6 0006-android-boot-handle-boot-header-v3-and-vendor-boot.patch
BOOTLOADER_PATCH_7 0007-android-dt-get-back-the-device-tree-index-based-on-b.patch
BOOTLOADER_PATCH_8 0008-fastboot-add-is-logical-variable-management.patch
BOOTLOADER_PATCH_9 0009-dts-use-bootloader-instead-of-fastoot-reboot-mode.patch
BOOTLOADER_PATCH_10 0010-configs-stm32-add-boot-command-for-Android.patch
BOOTLOADER_PATCH_11 0011-dts-use-retram-as-permanent-storage-for-debug.patch
BOOTLOADER_PATCH_12 0012-dts-add-stm32mp257f-dk-board-support-for-Android.patch
BOOTLOADER_PATCH_13 0013-configs-increase-max-args-for-env-set-command.patch
BOOTLOADER_PATCH_14 0014-board-st-set-density-level-depending-on-detected-dis.patch
