From 9a54cc309f5a7a737fb50fedd50e30df8bff36a3 Mon Sep 17 00:00:00 2001
From: Yves COPPEAUX <yves.coppeaux@st.com>
Date: Wed, 7 May 2025 09:01:00 +0200
Subject: [PATCH 5/8] trusty : BL32 OPTEE image specific process deleted

---
 plat/st/stm32mp2/bl2_plat_setup.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/plat/st/stm32mp2/bl2_plat_setup.c b/plat/st/stm32mp2/bl2_plat_setup.c
index 2fe094628..2a66f8f1e 100644
--- a/plat/st/stm32mp2/bl2_plat_setup.c
+++ b/plat/st/stm32mp2/bl2_plat_setup.c
@@ -789,6 +789,7 @@ int bl2_plat_handle_post_image_load(unsigned int image_id)
 			case BL32_IMAGE_ID:
 				bl_mem_params->ep_info.pc = config_info->config_addr;
 
+#ifdef SPD_opteed
 				/* In case of OPTEE, initialize address space with tos_fw addr */
 				pager_mem_params = get_bl_mem_params_node(BL32_EXTRA1_IMAGE_ID);
 				if (pager_mem_params != NULL) {
@@ -797,6 +798,7 @@ int bl2_plat_handle_post_image_load(unsigned int image_id)
 					pager_mem_params->image_info.image_max_size =
 						config_info->config_max_size;
 				}
+#endif
 				break;
 
 			case BL33_IMAGE_ID:
@@ -837,6 +839,7 @@ int bl2_plat_handle_post_image_load(unsigned int image_id)
 		break;
 
 	case BL32_IMAGE_ID:
+#ifdef SPD_opteed
 		if ((bl_mem_params->image_info.image_base != 0UL) &&
 		    (optee_header_is_valid(bl_mem_params->image_info.image_base))) {
 			/* BL32 is OP-TEE header */
@@ -857,6 +860,7 @@ int bl2_plat_handle_post_image_load(unsigned int image_id)
 			bl_mem_params->ep_info.args.arg1 = 0U; /* Unused */
 			bl_mem_params->ep_info.args.arg2 = 0U; /* No DT supported */
 		}
+#endif
 		break;
 
 #if STM32MP_M33_TDCID
-- 
2.34.1

